# ============================================================
#  wabot_python — copy to .env and fill in
# ============================================================

# ---------- Server ----------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
# Key guarding the /api/* routes (leave empty to disable the check)
ADMIN_API_KEY=change-this-key

# ---------- WhatsApp Cloud API (Meta) ----------
# Dashboard: developers.facebook.com > your app > WhatsApp > API Setup
WA_VERIFY_TOKEN=any-token-you-make-up
WA_ACCESS_TOKEN=EAAG...permanent-system-user-token
WA_PHONE_NUMBER_ID=123456789012345
WA_BUSINESS_ACCOUNT_ID=
# App secret (App settings > Basic) — used to validate the webhook signature
WA_APP_SECRET=
WA_GRAPH_VERSION=v26.0
# Allow-list of numbers (E.164 without "+", comma separated). Empty = reply to everyone.
WA_ALLOWED_NUMBERS=
WA_MARK_AS_READ=true
WA_TYPING_INDICATOR=true

# ---------- LLM routing ----------
DEFAULT_PROVIDER=openai
# Fallback order used when the primary provider fails (empty = no fallback)
PROVIDER_FALLBACK_ORDER=openai,anthropic,gemini
MAX_OUTPUT_TOKENS=1024
TEMPERATURE=0.6
REQUEST_TIMEOUT=90

# ---------- OpenAI ----------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
# OPENAI_BASE_URL=            # point to any compatible endpoint (LM Studio, vLLM, Ollama...)

# ---------- Anthropic ----------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---------- Google Gemini ----------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-flash

# ---------- Media ----------
# Who transcribes voice notes: openai | gemini | none
TRANSCRIPTION_PROVIDER=openai
MEDIA_MAX_BYTES=15728640

# ---------- Conversation memory ----------
HISTORY_MAX_MESSAGES=20
SUMMARIZE_AFTER_MESSAGES=40

# ---------- Database ----------
DATABASE_URL=sqlite+aiosqlite:///./data/wabot.db
